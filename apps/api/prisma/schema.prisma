// TaskFlow data model.
// Design mapped from the entity exercise: User, Workspace, Membership,
// Project, Board, Task, TaskAssignee.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL lives in prisma.config.ts (datasource.url),
  // not here. See https://pris.ly/d/config-datasource
}

// ---------- Enums (fixed sets of values) ----------

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

// ---------- Models (tables) ----------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // stored hashed later (Stage 2)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  memberships   Membership[] // 1 user -> many memberships (n-n with Workspace)
  authoredTasks Task[] // tasks this user created (1-n)
  assignedTasks TaskAssignee[] // tasks this user is assigned to (n-n)
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[] // 1 workspace -> many memberships
  projects    Project[] // 1 workspace -> many projects
  orgUnits    OrgUnit[] // 1 workspace -> many org units
}

// Junction table for User <-> Workspace (n-n), carries `role`.
model Membership {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId]) // a user joins a workspace only once
  @@index([workspaceId])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boards    Board[]

  @@index([workspaceId])
}

model Board {
  id        String   @id @default(uuid())
  name      String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String? // nullable
  status      TaskStatus @default(TODO)
  priority    Priority   @default(LOW)
  dueDate     DateTime? // nullable
  boardId     String
  authorId    String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  board     Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id])
  assignees TaskAssignee[]

  @@index([boardId])
  @@index([authorId])
}

// Junction table for Task <-> User (assignees, n-n).
model TaskAssignee {
  id        String   @id @default(uuid())
  taskId    String
  userId    String?
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId]) // assign a user to a task only once
  @@index([userId])
}

model OrgUnit {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asAncestor   OrgUnitClosure[] @relation("Ancestor")
  asDescendant OrgUnitClosure[] @relation("Descendant")

  @@index([workspaceId])
}

model OrgUnitClosure {
  ancestorId   String
  descendantId String
  depth        Int

  ancestor   OrgUnit @relation("Ancestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendant OrgUnit @relation("Descendant", fields: [descendantId], references: [id], onDelete: Cascade)

  @@id([ancestorId, descendantId])
  @@index([descendantId])
}
